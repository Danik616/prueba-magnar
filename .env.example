# Ano a consultar. Vacio = todos los anios.
SEARCH_ANIO=2024

# Delay minimo entre requests (ms)
REQUEST_DELAY_MS=1500

# Reintentos ante 429/403/5xx antes de rendirse
MAX_RETRIES=5

# Backoff base (ms). Escala 1 -> 2 -> 4 -> 8 -> 15s
RETRY_BASE_DELAY_MS=1000

# Techo del backoff (ms)
RETRY_MAX_DELAY_MS=15000

# Limites para pruebas cortas. 0 = sin limite.
MAX_PAGES=0
MAX_DOCUMENTS=0
